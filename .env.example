# Configure at least one cloud provider or an Ollama endpoint. Leave unused providers blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
MISTRAL_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Multiple keys for one provider: indexed entries override its single API_KEY.
# Source and `docker run --env-file` accept these directly; Compose requires an
# explicit service environment override. See docs/configuration.md#multiple-api-keys.
# LLMProxy__Providers__OpenAI__ApiKeys__0=provider-key-1
# LLMProxy__Providers__OpenAI__ApiKeys__1=provider-key-2
# LLMProxy__Providers__OpenAI__ApiKeyCooldownSeconds=30

# Microsoft Foundry: use the resource root or the full /openai/v1 endpoint.
# Model mappings use deployment names. The defaults expect gpt-4o-mini and gpt-5.
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_AUTHENTICATION=ApiKey
FOUNDRY_TOKEN_SCOPE=https://ai.azure.com/.default
# For EntraId authentication, use a managed identity or supply Azure credentials:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Ollama is enabled only with an explicit endpoint. A provider key is optional.
# Source example: http://localhost:11434/v1
# Docker/Compose host example: http://host.docker.internal:11434/v1
# Set the HTTP opt-in to true only for a trusted local Ollama server.
OLLAMA_ENDPOINT=
OLLAMA_API_KEY=
OLLAMA_ALLOW_INSECURE_HTTP=false

# Optional endpoint overrides; blank values keep the built-in/nested configuration.
# OPENAI_ENDPOINT=
# ANTHROPIC_ENDPOINT=
# GEMINI_ENDPOINT=
# MISTRAL_ENDPOINT=
# COHERE_ENDPOINT=
# DEEPSEEK_ENDPOINT=
# GROQ_ENDPOINT=

# Docker Compose dependencies: use separate strong passwords (e.g. openssl rand -hex 32).
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Optional bootstrap key: llmp_sk_ followed by at least 32 random URL-safe characters.
# Or leave blank and run the `keys create` command after startup.
LLMPROXY_BOOTSTRAP_KEY=
LLMPROXY_BOOTSTRAP_OWNER=bootstrap

# Optional bootstrap administrator key for /admin. Use a separate random 32+ character secret.
# Create local operator accounts through the console; they still work when this key is removed.
LLMPROXY_ADMIN_KEY=

LLMPROXY_IMAGE=mohammedtv/llmproxy:0.2.0
LLMPROXY_PORT=4000
LLMPROXY_AUTO_MIGRATE=true

# Optional OTLP collector, for example http://otel-collector:4317. Empty disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# For source or standalone Docker connected to external PostgreSQL + Redis:
# LLMProxy__Storage__Mode=PostgreSql
# ConnectionStrings__Postgres=Host=localhost;Database=llmproxy;Username=llmproxy;Password=...
# ConnectionStrings__Redis=localhost:6379,password=...,abortConnect=false
# For a custom JSON configuration mounted into the image, see docs/configuration.md.
# Named account example: LLMProxy__Providers__Accounts__openai-east__ApiKey=...
# Or a pool: LLMProxy__Providers__Accounts__openai-east__ApiKeys__0=...
# Models, accounts and prices can be reloaded with POST /admin/config/reload on each replica.
# Concurrency, retention and batch settings require restart. Compose needs explicit overrides:
# LLMProxy__Concurrency__PerKeyLimit=20
# LLMProxy__Storage__UsageRetentionDays=90
# LLMProxy__Storage__AuditRetentionDays=365
# LLMProxy__Storage__BatchRetentionDays=7
# LLMProxy__Batches__Workers=4
